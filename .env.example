# --- database ---
POSTGRES_USER=docs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docs
DATABASE_URL=postgresql+asyncpg://docs:change-me@db:5432/docs

# --- app ---
DEBUG=false
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATA_DIR=/data

# --- auth ---
SESSION_TTL_HOURS=336
# set to false only for plain-HTTP local access
COOKIE_SECURE=true

# --- quotas (global hard caps) ---
MAX_UPLOAD_MB=200
DEFAULT_DOMAIN_QUOTA_MB=5000
DEFAULT_TRASH_RETENTION_DAYS=30
EXPORT_TTL_HOURS=48
# set-archive cache file lifetime (per-domain override: set_archive_ttl_days)
SET_ARCHIVE_TTL_DAYS=7
# per-IP cap on the public GET /d/{token} endpoint
PUBLIC_DOWNLOAD_RATE_PER_MIN=60

# --- blob storage ---
# local -> DATA_DIR/blobs (default, no extra services)
# s3    -> any S3-compatible endpoint. Start a local one with
#            docker compose --profile s3 up -d
#          then set the vars below. Thumbnails / OCR sidecars / export zips
#          always stay on local disk regardless.
STORAGE_BLOBS=local
# S3_ENDPOINT=http://minio:9000          # host:port of the S3 API; unset = real AWS
# S3_ACCESS_KEY=docsclassifier
# S3_SECRET_KEY=change-me-minio
# S3_BUCKET=docsclassifier
# S3_REGION=us-east-1
# S3_ADDRESSING=path                     # path for MinIO/Garage, virtual for AWS
# S3_PRESIGN=true                        # redirect downloads straight to S3
# S3_PRESIGN_TTL=300
# Set only if the app reaches S3 over a private address browsers can't (e.g. a
# WireGuard peer): the public URL used to sign download redirects.
# S3_PUBLIC_ENDPOINT=https://s3.example.com
#
# Switching backends: `python -m app.storage.migrate --to s3 --commit` copies
# every existing blob across, then flip STORAGE_BLOBS.

# --- jobs ---
# queue  -> SAQ worker processes OCR / archive extraction / exports
# inline -> run them in-process (single-node dev without the worker container)
JOB_MODE=queue
OCR_DEFAULT_LANG=rus+eng

# --- file types (optional; unset = every domain allows every type by default;
# an owner/admin can still narrow their own domain via its settings) ---
# DEFAULT_ALLOWED_TYPES=pdf,docx,xlsx,png,jpg,jpeg

# --- absolute links & the Telegram bot ---
# Scheme+host used to build every absolute link the app hands out (share
# links, the bot's deep-links, the account-linking page). Required for the
# bot (it must send absolute URLs). Set once a (sub)domain points at the VDS;
# https://<vds-ip> works too before that.
# PUBLIC_BASE_URL=https://docs.example.com
#
# The `bot` compose service is opt-in — start it with:
#   docker compose --profile bot up -d --build
# after setting the three below (BOT_TOKEN from @BotFather):
# BOT_TOKEN=123456:AA...
# TELEGRAM_BOT_USERNAME=YourDocsBot   # no leading @, for the web-initiated deep-link
# BOT_SEARCH_PAGE_SIZE=5

# --- outbound email / registration confirmation (optional) ---
# Set SMTP_HOST to require a confirmed email before a new account can log in.
# Unset -> accounts are usable immediately. PUBLIC_BASE_URL must be set too so
# the confirmation link is absolute.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=change-me
# SMTP_FROM=DocsClassifier <no-reply@docs.example.com>
# SMTP_STARTTLS=true
# EMAIL_VERIFY_TTL_HOURS=48
